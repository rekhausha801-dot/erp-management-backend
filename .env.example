# Database
DATABASE_URL="postgresql://postgres:password@localhost:5432/erp_management?schema=public"

# JWT Authentication
JWT_SECRET="replace-with-secure-random-secret-key"
JWT_EXPIRES_IN="1d"
JWT_REFRESH_SECRET="replace-with-secure-random-refresh-secret-key"
JWT_REFRESH_EXPIRES_IN="7d"

# Application
PORT=5000
NODE_ENV=development
API_PREFIX="api/v1"
